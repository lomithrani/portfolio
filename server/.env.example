# API environment. Copy to server/.env (Bun loads it automatically) and adjust.
# On Railway, set the same names as service variables instead (see docs/DEPLOYMENT.md).

# --- Required ---------------------------------------------------------------

# MongoDB connection string (`bun run db:up` starts one on 127.0.0.1:27017)
MONGO_URL=mongodb://127.0.0.1:27017/portfolio
# Signs the session JWT. Use a long random value (32+ characters) anywhere but local dev
JWT_SECRET=change-me
# JSON array of the web origins allowed by CORS: dev server, Playwright/preview, production build
ALLOWED_DOMAINS=["http://localhost:5173","http://localhost:4173","http://localhost:4000"]

# --- Optional ---------------------------------------------------------------

# Port to listen on (default 3000; Railway injects PORT)
# PORT=3000
# Interface to bind (default '::', dual-stack). Without IPv6 the server falls back to 0.0.0.0
# unless HOST is set explicitly
# HOST=0.0.0.0
# Expected audience of Google ID tokens (default: DEFAULT_GOOGLE_CLIENT_ID from portfolio-common).
# Must match the web app's PUBLIC_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_ID=
# Client secret of that OAuth client (Google Cloud console). Enables Google Calendar appointments,
# which are off while it is unset (see docs/DEPLOYMENT.md, Google Calendar appointments)
# GOOGLE_CLIENT_SECRET=
# SameSite attribute of the auth cookie: strict (default), lax or none.
# The cookie is Secure when NODE_ENV=production or SameSite=none.
# CSRF: none sends the session with requests from any website (e.g. a hidden form); only the API's
# JSON-only rule (415 for a non-JSON POST/PUT/PATCH/DELETE) and CORS (ALLOWED_DOMAINS) stop them
# then. Keep strict unless web and API cannot share a site (see docs/DEPLOYMENT.md)
# AUTH_COOKIE_SAMESITE=strict
# OpenAPI docs are served whenever NODE_ENV is not production; set true to serve them in production too
# API_DOCS=true
# OpenTelemetry (traces, metrics, logs). Telemetry is fully off while the endpoint is unset
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceId:token>
# OTEL_SERVICE_NAME=portfolio-server
# Telemetry switches (standard OpenTelemetry names; used to bisect memory growth, see
# docs/DEPLOYMENT.md). true turns telemetry fully off, as if the endpoint were unset
# OTEL_SDK_DISABLED=false
# otlp (default) or none. none drops that signal's processor/reader and exporter; with traces none
# the Elysia tracing plugin is not installed either, and with logs none the logger only prints
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# Period of the 'memory' log line (RSS, heap, top object types) in ms: logged at startup, then
# every period. Default 600000 (10 minutes); 0 turns it off; otherwise at least 1000
# MEMORY_LOG_INTERVAL_MS=600000
# Serve HTTPS with server/cert.pem and server/key.pem, decrypted with this passphrase
# TLS_PASSPHRASE=
# production makes the cookie Secure and hides the API docs (Railpack sets it on Railway)
# NODE_ENV=development

# --- Tests only (`bun run test`) ---------------------------------------------

# Database the API tests use instead of MONGO_URL. The integration and Eden suites write to it,
# so keep it separate from the development database
# TEST_MONGO_URL=mongodb://127.0.0.1:27017/portfolio-test
