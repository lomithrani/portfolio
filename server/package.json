{
  "name": "portfolio-api",
  "module": "index.ts",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run --inspect --watch index.ts",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit -p .",
    "seed": "bun run tests/seedDb.ts",
    "seed:e2e": "bun run tests/seedE2e.ts",
    "kill": "sudo lsof -t -i:3000 | xargs sudo kill -9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@googleapis/calendar": "^20.1.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.30",
    "jose": "^6.2.14",
    "mongoose": "^9.11.4",
    "portfolio-common": "workspace:common"
  },
