{
	"name": "portfolio-client",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "bun --bun vite build",
		"preview": "vite preview",
		"test": "bun run test:e2e && bun run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"kill": "sudo lsof -t -i:5173 | xargs sudo kill -9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/google.accounts": "^0.0.18",
		"bun-types": "^1.4.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.0.0",
		"portfolio-api": "workspace:server",
		"portfolio-common": "workspace:common",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-heros-v2": "^3.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"@elysiajs/eden": "^1.4.9",
		"@opentelemetry/api": "~1.9.1",
		"@opentelemetry/api-logs": "^0.223.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
		"@opentelemetry/resources": "^2.12.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@opentelemetry/sdk-metrics": "^2.12.0",
		"@opentelemetry/sdk-node": "^0.223.0",
		"@opentelemetry/sdk-trace": "^2.12.0",
		"@opentelemetry/semantic-conventions": "^1.44.0",
		"dotenv": "^18.0.9",
		"highlight.js": "^11.12.0",
		"isomorphic-dompurify": "^4.6.0",
		"marked": "^18.1.2",
		"marked-highlight": "^2.2.4",
		"svelte-persisted-store": "^0.12.0"
	}
}
