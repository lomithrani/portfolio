{
  "name": "portfolio-client",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun run test:e2e && bun run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "kill": "sudo lsof -t -i:5173 | xargs sudo kill -9"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.2.7",
    "@neoconfetti/svelte": "^2.2.2",
    "@playwright/test": "^1.58.2",
    "@skeletonlabs/skeleton": "^4.12.0",
    "@skeletonlabs/skeleton-svelte": "^4.12.0",
    "@sveltejs/kit": "^2.51.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/cookie": "^1.0.0",
    "@types/google.accounts": "^0.0.18",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "bun-types": "^1.3.9",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "portfolio-api": "workspace:server",
    "portfolio-common": "workspace:common",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "5.49.0",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.3.6",
    "svelte-heros-v2": "^3.0.1",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "type": "module",
  "dependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.212.0",
