    "@opentelemetry/semantic-conventions": "^1.39.0",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.0.0-rc.2",
    "marked": "^17.0.2",
    "marked-highlight": "^2.2.3",
    "svelte-persisted-store": "^0.12.0"
