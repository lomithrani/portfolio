{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*.ts", "*.js"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "bun-types", "google.accounts"]
	}
	// Import aliases (#lib, #components, #images, #services) are Node subpath imports declared in
	// the `imports` field of package.json, which TypeScript and Vite resolve natively:
	// https://svelte.dev/docs/kit/$lib
	//
	// If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
	// from the referenced tsconfig.json - TypeScript does not merge them in
}
