# Web app environment. Copy to client/.env and adjust.
# The variables are read when the server starts (src/env.ts), so changing them needs no rebuild.
# On Railway, set the same names as service variables instead (see docs/DEPLOYMENT.md).

# Base URL of the API, used by server-side rendering and by the browser (default http://localhost:3000)
PUBLIC_PORTFOLIO_API_URL=http://localhost:3000
# Google Sign-In client ID (default: DEFAULT_GOOGLE_CLIENT_ID from portfolio-common).
# Must match the API's GOOGLE_CLIENT_ID
# PUBLIC_GOOGLE_CLIENT_ID=

# --- Production server (adapter-bun: `bun run start:client`); `bun run dev` ignores these ---

# Port to listen on. `bun run start:client` listens on 4000 unless PORT is set in the shell
# (`PORT=5000 bun run start:client`): the script sets PORT before Bun loads this file, and a .env
# value never overrides one already set. A PORT here only applies when running
# `bun --bun build/index.js` directly from client/. Railway injects PORT.
# PORT=4000
# Interface to bind (adapter-bun default 0.0.0.0)
# HOST=0.0.0.0
# ORIGIN: @sveltejs/adapter-bun does not read it (unlike adapter-node). The public origin is the
# request's Host header with https assumed, which is right behind Railway's TLS proxy. Behind a
# proxy that rewrites them, name the forwarded headers instead, e.g. PROTOCOL_HEADER=x-forwarded-proto
# and HOST_HEADER=x-forwarded-host.

# --- Optional ---------------------------------------------------------------

# OpenTelemetry (traces, metrics, logs). Telemetry is fully off while the endpoint is unset
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceId:token>
# OTEL_SERVICE_NAME=portfolio-client
