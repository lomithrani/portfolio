		{
			"type": "stat",
			"title": "Browser visits",
			"description": "Pages opened in a browser, on any part of the site: each one checks the session once (`GET /isLogged`). Navigating inside the site does not count again, and crawlers that run no JavaScript are not counted. Signed-in and anonymous visits cannot be told apart.",
			"datasource": {
				"type": "prometheus",
				"uid": "grafanacloud-prom"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "round(sum(increase(http_server_requests_total{service_name=~\"${stage:raw}\", route=\"/isLogged\", method=\"GET\", status!~\"[45]..\"}[$__range])))",
					"instant": true
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"noValue": "–",
					"color": {
