					"refId": "A",
					"queryType": "traceql",
					"query": "{resource.service.name=~\"${stage:raw}\" && name=\"sveltekit.handle.root\" && span.sveltekit.is_data_request=false && span.http.route!=\"/healthz\" && span.http.route!=\"unknown\"} | count_over_time() by (span.http.route)",
